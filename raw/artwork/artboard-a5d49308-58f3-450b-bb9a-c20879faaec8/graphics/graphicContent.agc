e":"solid","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"},"filters":[{"type":"dropShadow","global":true,"params":{"dropShadows":[{"dx":0,"dy":3,"r":3,"color":{"mode":"RGB","value":{"r":0,"g":0,"b":0},"alpha":0.1607843137254902}}]}}]},"visualBounds":{"x":-5300.00146484375,"y":-1804.9990234375,"width":358,"height":481.2149658203125},"shape":{"type":"path","path":"M 0 0 L 308.4275512695312 0 L 339.9998474121094 0 L 339.9998474121094 463.2149658203125 L 0 463.2149658203125 L 0 0 Z"}},{"type":"shape","name":"パス 39132","meta":{"ux":{"nameL10N":"SHAPE_PATH","rotation":29}},"id":"b4414f58-1015-42f5-bb73-ef2f36dabf0d","transform":{"a":0.8746196627616882,"b":0.48480960726737976,"c":-0.48480960726737976,"d":0.8746196627616882,"tx":7937.177734375,"ty":10407.16796875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"},"filters":[{"type":"dropShadow","global":true,"params":{"dropShadows":[{"dx":0,"dy":3,"r":3,"color":{"mode":"RGB","value":{"r":0,"g":0,"b":0},"alpha":0.1607843137254902}}]}}]},"visualBounds":{"x":-5134.7490234375,"y":-1983.30078125,"width":370.92529296875,"height":341.8609619140625},"shape":{"type":"path","path":"M 85.67733764648438 1.481571197509766 L 287.8027038574219 213.1243133544922 L 1.599575042724609 94.50022888183594 L 85.67733764648438 1.481571197509766 Z"}}]}},{"type":"text","name":"ある日、2本の古いロレックスが持ち込まれました。\n「両親の形見なんですが、箱や保証書もなく、止まっていて…」他店では「保証書、なくて動かないので厳しいです」「〇〇円」です。とかなり低い金額を言われたそうです。ですが当店で拝見するとそれは希少な年代のロレックスデイトジャストでした。文字盤の焼けも、針の経年劣化も、減額ではなく「個性」として評価できる価値ある個体でした。\nその旨と、査定額お伝えすると「ちゃんと見てもらえた気がします」と言っていただきました。\n※国内外にある多数の販路で最新の市場価値に基づく正確な","meta":{"ux":{"nameL10N":"SHAPE_GROUP","fixed":true,"customConstraints":true,"constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":269,"linkId":"","fontFamily":"Noto Sans JP","fontStyle":"Medium","fontSize":13,"charSpacing":50,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4281278213},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"c745bfba-ba82-4ecf-8708-4c49ae4b10c2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":48.701171875,"ty":8643},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":47,"g":31,"b":5}}},"font":{"family":"Noto Sans JP","style":"Medium","size":13},"textAttributes":{"letterSpacing":50,"lineHeight":19,"paragraphAfterSpacing":10}},"text":{"frame":{"type":"area","width":280,"height":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":20,"x":0}],[{"y":34,"from":20,"to":24,"x":0}]]},{"lines":[[{"y":63,"from":25,"to":44,"x":0}],[{"y":82,"from":44,"to":64,"x":0}],[{"y":101,"from":64,"to":84,"x":0}],[{"y":120,"from":84,"to":104,"x":0}],[{"y":139,"from":104,"to":124,"x":0}],[{"y":158,"from":124,"to":144,"x":0}],[{"y":177,"from":144,"to":164,"x":0}],[{"y":196,"from":164,"to":184,"x":0}]]},{"lines":[[{"y":225,"from":185,"to":205,"x":0}],[{"y":244,"from":205,"to":225,"x":0}],[{"y":263,"from":225,"to":228,"x":0}]]},{"lines":[[{"y":292,"from":229,"to":249,"x":0}],[{"y":311,"from":249,"to":269,"x":0}]]}],"rawText":"ある日、2本の古いロレックスが持ち込まれました。\n「両親の形見なんですが、箱や保証書もなく、止まっていて…」他店では「保証書、なくて動かないので厳しいです」「〇〇円」です。とかなり低い金額を言われたそうです。ですが当店で拝見するとそれは希少な年代のロレックスデイトジャストでした。文字盤の焼けも、針の経年劣化も、減額ではなく「個性」として評価できる価値ある個体でした。\nその旨と、査定額お伝えすると「ちゃんと見てもらえた気がします」と言っていただきました。\n※国内外にある多数の販路で最新の市場価値に基づく正確な査定をさせていただきます。"}},{"type":"group","name":"グループ 12676","meta":{"ux":{"nameL10N":"SHAPE_GROUP","fixed":true,"aspectLock":{"width":50,"height":50},"constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"dfb9258e-de8a-4880-b503-8cf84d53fc2d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":49,"ty":8569.626953125},"group":{"children":[{"type":"group","name":"グループ 12493","meta":{"ux":{"nameL10N":"